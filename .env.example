# Smart Contract Deployment Configuration
# Copy this file to .env and fill in your values

# Private Key of your deployer wallet (WITHOUT 0x prefix)
# Get this from MetaMask: Settings > Security & Privacy > Show Private Key
# ⚠️ NEVER commit the actual .env file with real private keys to GitHub!
PRIVATE_KEY=your_private_key_here

# BaseScan API Key (optional, for contract verification)
# Get from: https://basescan.org/apis
BASESCAN_API_KEY=your_basescan_api_key_here

# Network RPC URLs (defaults are already set in hardhat.config.js, optional override)
# RPC_URL_BASE_SEPOLIA=https://sepolia.base.org
# RPC_URL_BASE_MAINNET=https://mainnet.base.org
